{
  "name": "noeko",
  "version": "0.1.1",
  "type": "module",
  "packageManager": "bun@latest",
  "scripts": {
    "dev": "bun run db:up && concurrently --names \"SERVER,CLIENT\" \"bun --watch app/index.ts\" \"vite --host 0.0.0.0\"",
    "dev:docker": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "prod:docker": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build",
    "build": "tsc && vite build",
    "start": "NODE_ENV=production bun run app/index.ts",
    "test": "bun run test:server && bun run test:client",
    "test:server": "bun test --test-sequential --preload ./tests/setup.server.ts ./tests",
    "test:client": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,scss}\"",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d surrealdb",
    "db:down": "docker compose down",
    "db:migrate": "bun run scripts/syncDB.ts",
    "db:push": "bun run scripts/pushDB.ts",
    "db:backup": "sh scripts/backupDB.sh",
    "db:export": "sh scripts/exportDB.sh",
    "db:sql": "sh scripts/sql.sh",
    "util:reset-password": "bun run scripts/resetPassword.ts",
    "prepare": "husky"
  },
