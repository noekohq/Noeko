# This file contains local-only credentials for the isolated E2E environment.
# The database name must retain the `_test` suffix; the reset script refuses to
# operate against any other database.
PORT=3027
NODE_ENV=development
TOKEN_SECRET="e2e-local-token-secret"

MAX_LM_PROMPT_SIZE=100000
MAX_USER_NOTES=500
VITE_MAX_USER_NOTES=500

DEFAULT_SUPERUSERS=""

DB_PROTOCOL=http
DB_HOST=localhost
DB_PORT=8002
DB_NAMESPACE="noeko_e2e"
DB_DATABASE="noeko_e2e_test"
DB_USER="twig"
DB_PASSWORD="secret"
DB_HOST_CONNECTION="http://localhost:8002"

VITE_APP_ENV=test
VITE_SERVER_LOCATION="http://localhost:3027"
VITE_SERVER_HOST="localhost:3027"
CLIENT_ORIGIN="http://localhost:5174"
DEPLOYED_URL="http://localhost:5174"
VITE_DEPLOYED_URL="http://localhost:5174"

EMBEDDINGS_PROVIDER="deterministic"
EMBEDDINGS_MODEL="deterministic-sha256"
EMBEDDINGS_DIMENSION=768
LM_PROVIDER="deterministic"
GEMINI_API_KEY=""
GCP_PROJECT_ID=""
GCP_LOCATION=""

EMAIL_FROM="e2e@example.com"
RESEND_API_KEY="unused-in-initial-e2e-suite"

S3_ENDPOINT="http://localhost"
S3_ACCESS_KEY_ID="e2e-access-key"
S3_SECRET_ACCESS_KEY="e2e-secret-key"
S3_REGION="e2e-region"
S3_BUCKET="e2e-bucket"
