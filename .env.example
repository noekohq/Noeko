# Server Config
PORT=3400
NODE_ENV=production # development, production
TOKEN_SECRET="this-is-a-super-secret-string"

# Admin Config
DEFAULT_SUPERUSERS="janedoe@testxyz.com,johndoe@testxyz.com" # a comma-separated list of emails

# Database Config
DB_PROTOCOL=http
DB_HOST=surrealdb
DB_PORT=8000
DB_NAMESPACE="twig"
DB_DATABASE="twig"
DB_USER="twig"
DB_PASSWORD="secret"

# App Config
VITE_APP_ENV=development # development, production
VITE_SERVER_LOCATION="http://localhost:3400"
CLIENT_ORIGIN="http://localhost:5173"

# Docker Config
USER_ID=... # Run `id -u` to find
GROUP_ID=... # Run `id -g` to find

# Third Party Config
## Google
GEMINI_API_KEY=""
GOOGLE_CREDENTIALS_LOCATION=""

## Email
EMAIL_FROM=""
MAILBABY_API_KEY=""
MAILBABY_API_URL=""

## AWS
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""
S3_BUCKET=""
